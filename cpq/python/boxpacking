#!/usr/bin/env python3

import argparse
import csv
import io
import json
import sys
from dataclasses import dataclass
from typing import Any, Dict, List, Optional
from urllib.error import HTTPError, URLError
from urllib.request import Request, urlopen
try:
    from py3dbp import Packer, Bin, Item
except ImportError:
    sys.exit(
        "De library 'py3dbp' is niet geinstalleerd.\n"
        "Installeer met:  pip install py3dbp --break-system-packages"
    )

# ---------------------------------------------------------------------------
# Pas deze keys aan als jouw JSON-bestanden andere veldnamen gebruiken
# ---------------------------------------------------------------------------
ART_KEY_ID = "artikelnummer"
ART_KEY_NAAM = "artikelnaam"
ART_KEY_L = "lengte"
ART_KEY_B = "breedte"
ART_KEY_H = "hoogte"
ART_KEY_GEWICHT = "gewicht"          # optioneel veld, mag ontbreken

BOX_KEY_NAAM = "naam"
BOX_KEY_L = "lengte"
BOX_KEY_B = "breedte"
BOX_KEY_H = "hoogte"
BOX_KEY_MAXGEWICHT = "max_gewicht"   # optioneel veld, mag ontbreken

GITHUB_REPOSITORY = "hd-exclusiva/ServiceSets.com"
GITHUB_BRANCH = "main"
GITHUB_DATA_PATH = "data"

GITHUB_CONTENTS_URL = (
    f"https://api.github.com/repos/{GITHUB_REPOSITORY}"
    f"/contents/{GITHUB_DATA_PATH}?ref={GITHUB_BRANCH}"
)

GITHUB_HEADERS = {
    "Accept": "application/vnd.github+json",
    "User-Agent": "ServiceSets-verpakkingsadvies",
}
@dataclass
class Artikel:
    artikelnummer: str
    naam: str
    lengte: float
    breedte: float
    hoogte: float
    gewicht: float = 0.0

    @property
    def volume(self) -> float:
        return self.lengte * self.breedte * self.hoogte


@dataclass
class Verpakking:
    naam: str
    lengte: float
    breedte: float
    hoogte: float
    max_gewicht: Optional[float] = None

    @property
    def volume(self) -> float:
        return self.lengte * self.breedte * self.hoogte


@dataclass
class PakResultaat:
    verpakking: Verpakking
    past: bool
    gebruikt_volume_pct: float
    aantal_niet_passend: int


# ---------------------------------------------------------------------------
# Data inladen
# ---------------------------------------------------------------------------
def github_json(url: str) -> Any:
    """Haalt JSON op uit de GitHub Contents API."""
    request = Request(url, headers=GITHUB_HEADERS)

    try:
        with urlopen(request, timeout=30) as response:
            return json.loads(response.read().decode("utf-8"))
    except HTTPError as exc:
        raise RuntimeError(
            f"GitHub gaf HTTP-fout {exc.code} terug voor:\n{url}"
        ) from exc
    except URLError as exc:
        raise RuntimeError(
            f"Kan GitHub niet bereiken: {exc.reason}"
        ) from exc


def download_text(url: str) -> str:
    """Downloadt tekst van een raw GitHub-bestand."""
    request = Request(url, headers={"User-Agent": GITHUB_HEADERS["User-Agent"]})

    try:
        with urlopen(request, timeout=30) as response:
            return response.read().decode("utf-8-sig")
    except HTTPError as exc:
        raise RuntimeError(
            f"Kan GitHub-bestand niet downloaden, HTTP-fout {exc.code}:\n{url}"
        ) from exc
    except URLError as exc:
        raise RuntimeError(
            f"Kan GitHub-bestand niet downloaden: {exc.reason}"
        ) from exc


def vind_github_bestanden(url: str) -> List[Dict[str, Any]]:
    """
    Zoekt recursief naar data-bestanden in de GitHub-map.
    Alleen JSON, JSONL en CSV worden ingelezen.
    """
    inhoud = github_json(url)
    bestanden = []

    for item in inhoud:
        item_type = item.get("type")
        item_name = item.get("name", "").lower()

        if item_type == "dir":
            bestanden.extend(vind_github_bestanden(item["url"]))

        elif item_type == "file" and item_name.endswith(
            (".json", ".jsonl", ".csv")
        ):
            bestanden.append(item)

    return bestanden


def records_uit_json(data: Any) -> List[Dict[str, Any]]:
    """
    Zet verschillende JSON-structuren om naar een lijst records.

    Ondersteunde voorbeelden:
    - [...]
    - {"artikelen": [...]}
    - {"products": [...]}
    - {"data": [...]}
    """
    if isinstance(data, list):
        return [rij for rij in data if isinstance(rij, dict)]

    if isinstance(data, dict):
        mogelijke_lijsten = (
            "artikelen",
            "articles",
            "producten",
            "products",
            "verpakkingen",
            "boxes",
            "packaging",
            "data",
            "items",
            "records",
            "package_dimensions"
        )

        records = []

        for sleutel in mogelijke_lijsten:
            waarde = data.get(sleutel)

            if isinstance(waarde, list):
                records.extend(
                    rij for rij in waarde if isinstance(rij, dict)
                )

        if records:
            return records

        # Ook een enkel object wordt ondersteund.
        return [data]

    return []


def laad_records_uit_github() -> List[Dict[str, Any]]:
    """Laadt alle bruikbare records uit de GitHub data-map."""
    bestanden = vind_github_bestanden(GITHUB_CONTENTS_URL)
    alle_records = []

    if not bestanden:
        raise RuntimeError(
            f"Geen JSON-, JSONL- of CSV-bestanden gevonden in "
            f"{GITHUB_REPOSITORY}/{GITHUB_DATA_PATH}."
        )

    for bestand in bestanden:
        bestandsnaam = bestand["name"].lower()
        tekst = download_text(bestand["download_url"])

        try:
            if bestandsnaam.endswith(".json"):
                data = json.loads(tekst)
                records = records_uit_json(data)

            elif bestandsnaam.endswith(".jsonl"):
                records = []

                for regel in tekst.splitlines():
                    regel = regel.strip()

                    if regel:
                        record = json.loads(regel)

                        if isinstance(record, dict):
                            records.append(record)

            elif bestandsnaam.endswith(".csv"):
                try:
                    dialect = csv.Sniffer().sniff(tekst[:4096])
                except csv.Error:
                    dialect = csv.excel

                reader = csv.DictReader(
                    io.StringIO(tekst),
                    dialect=dialect,
                )
                records = [
                    dict(rij)
                    for rij in reader
                    if isinstance(rij, dict)
                ]

            else:
                records = []

        except (json.JSONDecodeError, csv.Error, UnicodeDecodeError) as exc:
            print(
                f"Waarschuwing: {bestand['name']} kan niet worden gelezen: "
                f"{exc}",
                file=sys.stderr,
            )
            continue

        for record in records:
            record["_bronbestand"] = bestand["name"]
            alle_records.append(record)

    return alle_records


def eerste_waarde(record: Dict[str, Any], sleutels: tuple) -> Any:
    """Geeft de eerste bestaande, niet-lege waarde terug."""
    for sleutel in sleutels:
        if sleutel in record and record[sleutel] not in (None, ""):
            return record[sleutel]

    return None


def getal(record: Dict[str, Any], sleutels: tuple, standaard: float = 0.0) -> float:
    waarde = eerste_waarde(record, sleutels)

    if waarde in (None, ""):
        return standaard

    if isinstance(waarde, str):
        waarde = waarde.replace(",", ".")

    return float(waarde)


def laad_artikelen_van_github(records: List[Dict[str, Any]]) -> List[Artikel]:
    artikelen = []

    for rij in records:
        artikelnummer = eerste_waarde(
            rij,
            (
                ART_KEY_ID,
                "artikelnummer",
                "article_number",
                "article_id",
                "sku",
                "id",
                "num"
            ),
        )

        naam = eerste_waarde(
            rij,
            (
                ART_KEY_NAAM,
                "artikelnaam",
                "productnaam",
                "naam",
                "name",
                "product_name",
            ),
        )

        lengte = eerste_waarde(
            rij,
            (ART_KEY_L, "length", "len", "l","lengte_cm"),
        )
        breedte = eerste_waarde(
            rij,
            (ART_KEY_B, "width", "w", "b","breedte_cm"),
        )
        hoogte = eerste_waarde(
            rij,
            (ART_KEY_H, "height", "h", "hoogte_cm"),
        )

        # Een productrecord moet minimaal een ID en drie afmetingen hebben.
        if None in (artikelnummer, lengte, breedte, hoogte):
            continue

        try:
            artikelen.append(
                Artikel(
                    artikelnummer=str(artikelnummer),
                    naam=str(naam or artikelnummer),
                    lengte=float(str(lengte).replace(",", ".")),
                    breedte=float(str(breedte).replace(",", ".")),
                    hoogte=float(str(hoogte).replace(",", ".")),
                    gewicht=getal(
                        rij,
                        (
                            ART_KEY_GEWICHT,
                            "weight",
                            "massa",
                        ),
                    ),
                )
            )
        except (TypeError, ValueError):
            print(
                f"Waarschuwing: ongeldig productrecord uit "
                f"{rij.get('_bronbestand', 'onbekend')} wordt overgeslagen.",
                file=sys.stderr,
            )

    return artikelen


def laad_verpakkingen_van_github(
    records: List[Dict[str, Any]],
) -> List[Verpakking]:
    verpakkingen = []

    for rij in records:
        naam = eerste_waarde(
            rij,
            (
                BOX_KEY_NAAM,
                "verpakkingsnaam",
                "box_name",
                "box",
                "name",
            ),
        )

        lengte = eerste_waarde(
            rij,
            (BOX_KEY_L, "length", "len", "l"),
        )
        breedte = eerste_waarde(
            rij,
            (BOX_KEY_B, "width", "w", "b"),
        )
        hoogte = eerste_waarde(
            rij,
            (BOX_KEY_H, "height", "h"),
        )

        # Een verpakkingsrecord moet een naam en drie afmetingen hebben.
        if None in (naam, lengte, breedte, hoogte):
            continue

        try:
            max_gewicht_waarde = eerste_waarde(
                rij,
                (
                    BOX_KEY_MAXGEWICHT,
                    "max_weight",
                    "maximum_weight",
                    "weight_limit",
                ),
            )

            max_gewicht = (
                None
                if max_gewicht_waarde in (None, "")
                else float(
                    str(max_gewicht_waarde).replace(",", ".")
                )
            )

            verpakkingen.append(
                Verpakking(
                    naam=str(naam),
                    lengte=float(str(lengte).replace(",", ".")),
                    breedte=float(str(breedte).replace(",", ".")),
                    hoogte=float(str(hoogte).replace(",", ".")),
                    max_gewicht=max_gewicht,
                )
            )
        except (TypeError, ValueError):
            print(
                f"Waarschuwing: ongeldig verpakkingsrecord uit "
                f"{rij.get('_bronbestand', 'onbekend')} wordt overgeslagen.",
                file=sys.stderr,
            )

    return verpakkingen
# ---------------------------------------------------------------------------
# Artikelselectie
# ---------------------------------------------------------------------------
def kies_artikelen_interactief(artikelen: List[Artikel]) -> List[Artikel]:
    print("\nBeschikbare artikelen:")
    for i, a in enumerate(artikelen, start=1):
        print(
            f"  {i:>3}. {a.artikelnummer:<10} {a.naam:<30} "
            f"{a.lengte}x{a.breedte}x{a.hoogte}"
        )

    print(
        "\nGeef de nummers van de te selecteren artikelen, gescheiden door "
        "een komma. Voeg optioneel een aantal toe met ':' (bv. 1:2,3:1)."
    )
    keuze = input("Selectie: ").strip()
    return _verwerk_selectie(keuze, artikelen, via_index=True)


def _verwerk_selectie(
    selectie_string: str, artikelen: List[Artikel], via_index: bool
) -> List[Artikel]:
    """Zet een selectie-string ('1:2,3' of 'A001:2,A004:1') om in een lijst
    Artikel-objecten, waarbij een artikel met aantal N ook N keer in de
    lijst voorkomt (elk item moet apart worden ingepakt)."""
    resultaat: List[Artikel] = []
    lookup_index = {str(i + 1): a for i, a in enumerate(artikelen)}
    lookup_nummer = {a.artikelnummer: a for a in artikelen}

    for deel in selectie_string.split(","):
        deel = deel.strip()
        if not deel:
            continue
        if ":" in deel:
            ref, aantal_str = deel.split(":", 1)
            aantal = int(aantal_str)
        else:
            ref, aantal = deel, 1

        artikel = lookup_index.get(ref) if via_index else lookup_nummer.get(ref)
        if artikel is None:
            # val ook terug op artikelnummer, voor de zekerheid
            artikel = lookup_nummer.get(ref)
        if artikel is None:
            print(f"  Waarschuwing: '{ref}' niet gevonden, wordt overgeslagen.")
            continue

        resultaat.extend([artikel] * aantal)

    return resultaat


# ---------------------------------------------------------------------------
# 3D bin packing
# ---------------------------------------------------------------------------
def past_in_verpakking(
    artikelen: List[Artikel], verpakking: Verpakking
) -> PakResultaat:
    """Probeert alle geselecteerde artikelen in 1 verpakking te passen met
    py3dbp en geeft het resultaat terug (past ja/nee, benut volume %, aantal
    artikelen dat niet paste)."""
    packer = Packer()

    max_gewicht = verpakking.max_gewicht if verpakking.max_gewicht else 1_000_000
    packer.add_bin(
        Bin(
            verpakking.naam,
            verpakking.lengte,
            verpakking.breedte,
            verpakking.hoogte,
            max_gewicht,
        )
    )

    for i, a in enumerate(artikelen):
        packer.add_item(
            Item(
                f"{a.artikelnummer}#{i}",
                a.lengte,
                a.breedte,
                a.hoogte,
                a.gewicht,
            )
        )

    packer.pack(bigger_first=True, distribute_items=False, number_of_decimals=2)

    doos = packer.bins[0]
    aantal_niet_passend = len(doos.unfitted_items)
    past = aantal_niet_passend == 0

    totaal_artikel_volume = sum(a.volume for a in artikelen)
    gebruikt_pct = (
        (totaal_artikel_volume / verpakking.volume) * 100
        if verpakking.volume
        else 0.0
    )

    return PakResultaat(
        verpakking=verpakking,
        past=past,
        gebruikt_volume_pct=round(min(gebruikt_pct, 100.0), 1),
        aantal_niet_passend=aantal_niet_passend,
    )


def vind_passende_verpakkingen(
    artikelen: List[Artikel], verpakkingen: List[Verpakking]
) -> List[PakResultaat]:
    """Test alle verpakkingen, klein naar groot (op volume), en geeft de
    resultaten terug in diezelfde volgorde. Zo zie je meteen de kleinste
    passende doos bovenaan, met steeds grotere alternatieven erna."""
    gesorteerd = sorted(verpakkingen, key=lambda v: v.volume)
    return [past_in_verpakking(artikelen, v) for v in gesorteerd]


# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------
def print_advies(artikelen: List[Artikel], resultaten: List[PakResultaat]) -> None:
    print("\nGeselecteerde artikelen:")
    for a in artikelen:
        print(f"  - {a.artikelnummer} {a.naam} ({a.lengte}x{a.breedte}x{a.hoogte})")

    print("\nVerpakkingsadvies (klein -> groot):")
    passende = [r for r in resultaten if r.past]

    if not passende:
        print("  Geen enkele verpakking uit de lijst is groot genoeg.")
        print("  Dichtstbijzijnde optie(s):")
        for r in resultaten[:3]:
            print(
                f"    - {r.verpakking.naam}: {r.aantal_niet_passend} "
                f"artikel(en) passen niet"
            )
        return

    for r in passende:
        markering = " <== KLEINST PASSENDE" if r == passende[0] else ""
        print(
            f"  - {r.verpakking.naam:<20} "
            f"{r.verpakking.lengte}x{r.verpakking.breedte}x{r.verpakking.hoogte}  "
            f"(volume benut: {r.gebruikt_volume_pct}%){markering}"
        )


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main() -> None:
    parser = argparse.ArgumentParser(
        description=(
            "Selecteer artikelen uit GitHub en vind passende verpakkingen."
        )
    )

    parser.add_argument(
        "--select",
        help=(
            "Rechtstreeks selecteren op artikelnummer, "
            "bijvoorbeeld 'A001:2,A004:1'."
        ),
    )

    args = parser.parse_args()

    try:
        print("Data ophalen uit GitHub...")

        records = laad_records_uit_github()
        artikelen_beschikbaar = laad_artikelen_van_github(records)
        verpakkingen = laad_verpakkingen_van_github(records)

    except RuntimeError as exc:
        sys.exit(f"Fout bij ophalen van GitHub-data: {exc}")

    if not artikelen_beschikbaar:
        sys.exit(
            "Geen producten met geldige afmetingen gevonden in de GitHub-data."
        )

    if not verpakkingen:
        sys.exit(
            "Geen verpakkingen met geldige afmetingen gevonden in "
            "de GitHub-data."
        )

    print(
        f"{len(artikelen_beschikbaar)} producten en "
        f"{len(verpakkingen)} verpakkingen geladen."
    )

    if args.select:
        geselecteerd = _verwerk_selectie(
            args.select,
            artikelen_beschikbaar,
            via_index=False,
        )
    else:
        geselecteerd = kies_artikelen_interactief(
            artikelen_beschikbaar
        )

    if not geselecteerd:
        sys.exit("Geen geldige artikelen geselecteerd, script stopt.")

    resultaten = vind_passende_verpakkingen(
        geselecteerd,
        verpakkingen,
    )

    print_advies(geselecteerd, resultaten)

if __name__ == "__main__":
    main()
